{
  "name": "omni-cad-monorepo",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build && pnpm --filter omni-cad run package && node scripts/copy-vsix-to-root.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:agents": "node scripts/validate-agent-workflow.mjs && node scripts/validate-capability-claims.mjs",
    "test:e2e": "turbo run test:e2e || true && cd packages/extension && npx ts-node scripts/finalize-docs.ts",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,html,css}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@vscode/test-electron": "^2.5.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16"
  },
  "workspaces": [
    "packages/extension",
    "packages/shared-types",
    "packages/landing"
  ],
  "packageManager": "pnpm@11.5.2"
}
