{
  "name": "omni-cad",
  "displayName": "OmniCAD",
  "description": "Universal CAD engine frontend router for VS Code",
  "version": "1.4.0",
  "publisher": "omni-cad",
  "keywords": [
    "cad",
    "freecad",
    "openscad",
    "3d",
    "engineering",
    "viewer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/el-j/omni-cad.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/el-j/omni-cad#readme",
  "bugs": {
    "url": "https://github.com/el-j/omni-cad/issues"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:scad",
    "onCommand:omniCAD.openViewer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "omniCAD.openViewer",
        "title": "OmniCAD: Open Viewer"
      },
      {
        "command": "omniCAD.runSetup",
        "title": "OmniCAD: Run Setup"
      }
    ],
    "configuration": {
      "title": "OmniCAD",
      "properties": {
        "omniCAD.freecadPath": {
          "type": "string",
          "default": "FreeCADCmd",
          "description": "Path to the FreeCADCmd executable"
        },
        "omniCAD.openscadPath": {
          "type": "string",
          "default": "openscad",
          "description": "Path to the openscad CLI executable"
        },
        "omniCAD.mcpEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the guarded OmniCAD MCP server entrypoint."
        },
        "omniCAD.enableExperimentalOpenGeometry": {
          "type": "boolean",
          "default": false,
          "description": "Enable the experimental OpenGeometry preview until a real runtime is implemented."
        },
        "omniCAD.autoSetupOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Run first-open CAD engine discovery and setup prompts during activation."
        },
        "omniCAD.renderScale": {
          "type": "number",
          "default": 0.1,
          "description": "Global scaling factor for the 3D viewer. Useful for scaling mm models to a manageable size."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "build": "pnpm run compile",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "mcp:stdio": "node ./dist/mcp/entry.js",
    "pretest": "pnpm --filter @omni-cad/shared-types run build && tsc --project tsconfig.json",
    "test": "node ./dist/test/suite/index.js",
    "test:coverage": "c8 --check-coverage --lines 90 --branches 70 --functions 55 --statements 90 --all --include=\"dist/**/*.js\" --exclude=\"dist/test/**\" --exclude=\"dist/webview/**\" --reporter=text --reporter=json-summary node ./dist/test/suite/index.js",
    "pretest:e2e": "pnpm --filter @omni-cad/shared-types run build && tsc --project tsconfig.json",
    "test:e2e": "playwright test",
    "package": "pnpm run compile && vsce package --no-dependencies"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@omni-cad/shared-types": "workspace:*",
    "opengeometry": "github:OpenGeometry-io/OpenGeometry",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "playwright": "^1.59.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semantic-release": "^25.0.3",
    "three": "^0.184.0",
    "typescript": "^6.0.3"
  }
}
